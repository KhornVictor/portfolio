# Base URL of the Express API. Leave empty in dev (Vite proxies /api to localhost:5000).
# In production point it at the deployed backend, e.g. https://api.khornvictor.com
VITE_API_URL=

# Public base URL for images (Supabase Storage bucket "Portfolio").
# Leave empty to serve from /public/images.
VITE_IMAGE_BASE=https://ybekylchdoekuloebtvn.supabase.co/storage/v1/object/public/Portfolio
